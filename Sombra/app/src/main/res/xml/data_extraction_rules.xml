<?xml version="1.0" encoding="utf-8"?>
<!-- Cópias de segurança e passagem para um telemóvel novo (Android 12+):
     tudo menos a sessão do Supabase. No telemóvel novo a pessoa entra outra vez e os dados voltam da conta. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sombra_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sombra_auth.xml" />
    </device-transfer>
</data-extraction-rules>
